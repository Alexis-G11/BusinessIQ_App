# Copy to .env for local development. Replace placeholders locally; never commit secrets.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006

# PostgreSQL: async URL for the API and direct URL for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Auth (the service-role key is server-side only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
# Set only for a legacy HS256 signing configuration.
SUPABASE_JWT_SECRET=
AUTH_EMAIL_REDIRECT_URL=http://localhost:8081/auth/callback

# Billing provider. Keep real values in a local ignored .env or managed secret store.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional until a backend assistant is implemented.
ANTHROPIC_API_KEY=
